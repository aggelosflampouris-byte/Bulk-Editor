# ──────────────────────────────────────────────────────────────────────────────
# .env.example — API Keys for Batch Greek Shorts Processing Engine
# ──────────────────────────────────────────────────────────────────────────────
# Rename this file to .env and fill in your keys.
# ──────────────────────────────────────────────────────────────────────────────

# Pexels API Key — free at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key_here

# Google Gemini API Key — free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Primary YouTube Channel for Niche Explorer
CONNECTED_CHANNEL=https://www.youtube.com/@YourChannel
